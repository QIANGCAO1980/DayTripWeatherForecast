<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Day Trip Weather Forecast</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Day Trip Weather Forecast">
<style>
:root{--ink:#1c2a38;--mute:#5d6e7c;--paper:#edf2f0;--card:#fbfdfc;--line:#cfdad6;--rain:#2f6a9f;--good:#2f7d57;
 box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--ink:#e6eef0;--mute:#9aaab6;--paper:#121b22;--card:#1a2630;--line:#2c3b47;--rain:#6fb0e6;--good:#5fc08c}}
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.4 -apple-system,system-ui,sans-serif}
main{max-width:600px;margin:0 auto;padding:16px 16px 40px}
h1{font:600 28px/1.1 ui-serif,"New York",Georgia,serif;margin:4px 0 2px}
.sub{color:var(--mute);font-size:14px;margin:0 0 16px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:14px}
label,.lab{display:block;font-size:13px;color:var(--mute);margin-bottom:6px}
input[type=range]{width:100%;accent-color:var(--rain)}
input[type=search]{font:inherit;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:9px 10px;width:100%}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.strip{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin-top:10px}
button{font:inherit;font-size:14px;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:6px 12px}
.strip button{border-radius:12px;min-width:48px;padding:6px 4px;text-align:center;line-height:1.2;flex:0 0 auto}
.strip b{display:block;font-size:17px}
button[aria-pressed=true]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
button:focus-visible,input:focus-visible{outline:2px solid var(--rain);outline-offset:2px}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.big{font:600 22px ui-serif,Georgia,serif}
.hits{margin-top:8px;display:flex;flex-direction:column;gap:6px}
.hits button{text-align:left;border-radius:10px}
.town{padding:12px 0;border-top:1px solid var(--line)}
.town:first-child{border-top:0}
.name{font-weight:600}
.meta{font-size:13px;color:var(--mute)}
.days{display:flex;gap:6px;overflow-x:auto;margin-top:8px}
.d{flex:1 0 74px;background:var(--paper);border-radius:10px;padding:8px 6px;text-align:center}
.d .ico{font-size:26px}
.d .t{font:600 16px ui-serif,Georgia,serif}
.d .t small{font:13px -apple-system,sans-serif;color:var(--mute)}
.rain{color:var(--rain)}
.pick{color:var(--good);font-size:12px;font-weight:600}
.x{border:0;background:none;color:var(--mute);padding:0 4px;font-size:13px;text-decoration:underline}
.msg{color:var(--mute);text-align:center;padding:18px 0}
</style>
</head>
<body>
<main>
 <h1>Day Trip Weather Forecast</h1>
 <p class="sub" id="fromLine"></p>

 <section class="panel">
  <label for="o">Starting from: <b id="oName"></b></label>
  <input type="search" id="o" placeholder="Type a city to change your starting point" autocomplete="off">
  <div class="hits" id="oHits"></div>
  <div class="chips" style="margin-top:8px"><button id="loc">Use my location</button><button id="home">Reset to Vaughan</button></div>
 </section>

 <section class="panel">
  <span class="lab">Days (tap to select several)</span>
  <div class="chips"><button id="wk0">This weekend</button><button id="wk1">Next weekend</button><button id="clr">Clear</button></div>
  <div class="strip" id="strip"></div>
  <div style="margin-top:14px">
   <div class="row"><label for="hrs" style="margin:0">Max drive time</label><span class="big" id="hrsOut"></span></div>
   <input type="range" id="hrs" min="30" max="210" step="15" value="90">
  </div>
  <div class="chips" id="sort" style="margin-top:10px" role="group" aria-label="Sort by">
   <button data-s="drive" aria-pressed="true">Closest first</button>
   <button data-s="weather" aria-pressed="false">Best weather first</button>
  </div>
 </section>

 <section class="panel">
  <label for="q">Add a town by name</label>
  <input type="search" id="q" placeholder="Start typing, e.g. Tob… or Buffalo" autocomplete="off">
  <div class="hits" id="hits"></div>
  <div class="meta" id="mine" style="margin-top:8px"></div>
 </section>

 <section class="panel" id="results"><div class="msg">Select at least one day.</div></section>
 <p class="sub">Forecast: Open-Meteo. Drive times marked ~ are straight-line estimates, not traffic-aware.</p>
</main>

<script>
const VAUGHAN={name:"Vaughan",lat:43.836,lon:-79.508,home:true};
// name, minutes by car from Vaughan (approx.), lat, lon
const BASE=[
["Uxbridge",40,44.109,-79.120],["Orangeville",55,43.920,-80.097],["Jackson’s Point",50,44.307,-79.462],
["Barrie",55,44.389,-79.690],["Hamilton",60,43.256,-79.869],["Guelph",60,43.545,-80.248],
["Burlington",50,43.325,-79.799],["Orillia",65,44.608,-79.420],["Elora",75,43.683,-80.435],
["Kitchener–Waterloo",75,43.451,-80.492],["Beamsville (wine)",75,43.168,-79.478],["Cobourg",85,43.960,-78.170],
["Midland",85,44.750,-79.883],["Niagara Falls",90,43.089,-79.084],["Niagara-on-the-Lake",95,43.255,-79.071],
["Peterborough",100,44.300,-78.320],["Wasaga Beach",100,44.521,-80.017],["Gravenhurst",100,44.917,-79.370],
["Collingwood",105,44.500,-80.217],["Bracebridge",110,45.038,-79.308],["Thornbury",115,44.564,-80.456],
["Stratford",120,43.370,-80.982],["Huntsville",135,45.327,-79.216],["Owen Sound",150,44.567,-80.943],
["Picton (Prince Edward Co.)",165,44.007,-77.142],["Algonquin (West Gate)",180,45.52,-78.70],["Kingston",190,44.231,-76.486],
// Eastern Ontario, Québec and nearby US (no curated Vaughan time; drive times are estimated)
["Ottawa",null,45.421,-75.697],["Cornwall",null,45.021,-74.730],["Brockville",null,44.590,-75.684],["Hawkesbury",null,45.608,-74.605],
["Valleyfield",null,45.265,-74.133],["Oka",null,45.468,-74.087],["Saint-Sauveur",null,45.894,-74.157],["Mont-Tremblant",null,46.118,-74.596],
["Saint-Donat",null,46.317,-74.222],["Joliette",null,46.017,-73.436],["Mont-Saint-Hilaire",null,45.567,-73.190],["Saint-Hyacinthe",null,45.630,-72.957],
["Granby",null,45.400,-72.733],["Sutton",null,45.108,-72.614],["Magog",null,45.265,-72.148],["Sherbrooke",null,45.404,-71.893],
["Trois-Rivières",null,46.343,-72.543],["Québec City",null,46.813,-71.208],["Plattsburgh, NY",null,44.699,-73.452],
["Burlington, VT",null,44.476,-73.212],["Lake Placid, NY",null,44.279,-73.980]
].map(t=>({name:t[0],vaughan:t[1],lat:t[2],lon:t[3]}));

const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const store={get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
let sort="drive",seq=0,sel=new Set(),custom=store.get("dtw_custom",[]),origin=store.get("dtw_origin",VAUGHAN);

const iso=d=>{const z=new Date(d.getTime()-d.getTimezoneOffset()*6e4);return z.toISOString().slice(0,10)};
const addDays=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x};
const today=new Date();today.setHours(12,0,0,0);
const dayObj=s=>new Date(s+"T12:00:00");
const dl=s=>dayObj(s).toLocaleDateString("en-CA",{weekday:"short",day:"numeric"});
function icon(c){
 if(c===0)return"☀️";if(c<=2)return"🌤️";if(c===3)return"☁️";if(c<=48)return"🌫️";
 if(c<=57)return"🌦️";if(c<=67)return"🌧️";if(c<=77)return"🌨️";if(c<=82)return"🌧️";if(c<=86)return"🌨️";return"⛈️"}
const score=w=>-(w.pop||0)-Math.abs(w.hi-22)*2-w.wind*0.4;
const mins=m=>m>=60?Math.floor(m/60)+" h"+(m%60?" "+m%60+" min":""):m+" min";
function estDrive(lat,lon){
 const R=6371,r=x=>x*Math.PI/180,dLa=r(lat-origin.lat),dLo=r(lon-origin.lon);
 const a=Math.sin(dLa/2)**2+Math.cos(r(origin.lat))*Math.cos(r(lat))*Math.sin(dLo/2)**2;
 return Math.max(10,Math.round(2*R*Math.asin(Math.sqrt(a))*1.3/85*60/5)*5)}
// Curated Vaughan times are used only when starting from Vaughan; otherwise estimated.
const driveOf=t=>origin.home&&t.vaughan!=null?{m:t.vaughan,est:false}:{m:estDrive(t.lat,t.lon),est:true};

function setOrigin(o){origin=o;store.set("dtw_origin",o);showOrigin();load()}
function showOrigin(){$("oName").textContent=origin.name;$("fromLine").textContent="From "+origin.name+". Pick days, set a drive time, add any town."}

// Type-ahead: local matches from 1 letter, online matches from 3 letters (service limit)
function typeahead(inp,hitsEl,localFn,onPick){
 let n=0,timer;
 const draw=(items,note)=>{
  hitsEl.innerHTML=items.map((p,i)=>`<button data-i="${i}">${esc(p.label)}</button>`).join("")+(note?`<div class="meta">${note}</div>`:"");
  hitsEl.onclick=e=>{const b=e.target.closest("button");if(!b)return;onPick(items[+b.dataset.i]);inp.value="";hitsEl.innerHTML=""}};
 inp.addEventListener("input",()=>{
  clearTimeout(timer);const q=inp.value.trim(),my=++n;
  if(!q){hitsEl.innerHTML="";return}
  const loc=localFn(q);
  draw(loc,q.length<3?"Type 3+ letters to search more places.":"Searching…");
  if(q.length<3)return;
  timer=setTimeout(async()=>{
   try{
    const r=await fetch("https://geocoding-api.open-meteo.com/v1/search?count=6&language=en&name="+encodeURIComponent(q));
    const res=((await r.json()).results||[]).map(p=>{const name=p.name+(p.admin1?", "+p.admin1:"");
     return{name,lat:p.latitude,lon:p.longitude,label:name+(p.country?", "+p.country:"")}});
    if(my!==n)return;
    const seen=new Set(loc.map(x=>x.name));
    const all=loc.concat(res.filter(x=>!seen.has(x.name)));
    draw(all,all.length?"":"No match. Try another spelling.");
   }catch(e){if(my===n)draw(loc,"Couldn’t search online. Check your connection.")}
  },250)});
}
const localTowns=q=>{const s=q.toLowerCase();
 return BASE.filter(t=>t.name.toLowerCase().split(/[\s(–-]+/).some(w=>w.startsWith(s))||t.name.toLowerCase().startsWith(s)).slice(0,5)
  .map(t=>({name:t.name,lat:t.lat,lon:t.lon,label:t.name}))};

typeahead($("q"),$("hits"),localTowns,p=>{
 if(!custom.some(c=>c.name===p.name))custom.push({name:p.name,lat:p.lat,lon:p.lon});
 store.set("dtw_custom",custom);renderMine();load()});
typeahead($("o"),$("oHits"),()=>[],p=>setOrigin({name:p.name,lat:p.lat,lon:p.lon,home:false}));

$("loc").onclick=()=>{
 if(!navigator.geolocation){alert("Location isn’t available in this browser.");return}
 navigator.geolocation.getCurrentPosition(
  p=>setOrigin({name:"My location",lat:p.coords.latitude,lon:p.coords.longitude,home:false,live:true}),
  ()=>alert("Couldn’t get your location. Allow location access for this site in Safari settings, or type a city instead."),
  {timeout:10000});
};
$("home").onclick=()=>setOrigin(VAUGHAN);

function buildStrip(){
 $("strip").innerHTML=Array.from({length:16},(_,i)=>{const s=iso(addDays(today,i));
  const d=dayObj(s);return `<button data-d="${s}" aria-pressed="${sel.has(s)}">${d.toLocaleDateString("en-CA",{weekday:"short"})}<b>${d.getDate()}</b></button>`}).join("")}
function weekend(offset){
 const sat=addDays(today,((6-today.getDay()+7)%7)+7*offset),sun=addDays(sat,1),last=iso(addDays(today,15));
 sel=new Set([iso(sat),iso(sun)].filter(s=>s<=last));buildStrip();load()}
function renderMine(){
 $("mine").innerHTML=custom.length?"Your towns: "+custom.map((t,i)=>`${esc(t.name)} <button class="x" data-i="${i}">remove</button>`).join(" · "):""}

// Finds towns/cities around any starting point (OpenStreetMap via Overpass). Skipped for Vaughan, which uses the curated list.
const nearCache={};
const close=(a,b)=>Math.abs(a.lat-b.lat)<0.08&&Math.abs(a.lon-b.lon)<0.08;
async function findNearby(max){
 if(origin.home)return[];
 const key=origin.lat.toFixed(2)+","+origin.lon.toFixed(2)+","+max;
 if(nearCache[key])return nearCache[key];
 const q='[out:json][timeout:20];node(around:'+Math.round(max*1090)+','+origin.lat+','+origin.lon+')[place~"^(city|town)$"][name];out 400;';
 try{
  const r=await fetch("https://overpass-api.de/api/interpreter",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:"data="+encodeURIComponent(q)});
  if(!r.ok)throw new Error(r.status);
  const j=await r.json();
  const w=e=>(+e.tags.population||0)+(e.tags.place==="city"?1e5:0);
  return nearCache[key]=j.elements.sort((a,b)=>w(b)-w(a)).slice(0,40).map(e=>({name:e.tags.name,lat:e.lat,lon:e.lon}));
 }catch(e){return[]}
}

async function load(){
 const my=++seq,max=+$("hrs").value,days=[...sel].sort();
 $("hrsOut").textContent=mins(max);
 const box=$("results");
 if(!days.length){box.innerHTML='<div class="msg">Select at least one day.</div>';return}
 if(!origin.home)box.innerHTML='<div class="msg">Finding towns near '+esc(origin.name)+'…</div>';
 const found=await findNearby(max);
 if(my!==seq)return;
 const base=BASE.map(t=>({...t,d:driveOf(t)})).filter(t=>t.d.m<=max);
 const have=new Set(base.concat(custom).map(t=>t.name.toLowerCase()));
 const extra=found.map(t=>({...t,d:{m:estDrive(t.lat,t.lon),est:true}}))
  .filter(t=>t.d.m<=max&&!have.has(t.name.toLowerCase())&&!base.some(b=>close(b,t))&&!close(t,origin));
 const list=base.concat(extra).concat(custom.map(t=>({...t,d:{m:estDrive(t.lat,t.lon),est:true},custom:true})));
 if(!list.length){box.innerHTML=`<div class="msg">No built-in towns within ${mins(max)} of ${esc(origin.name)}. Raise the drive time, or add towns by name in the box above.<br>The built-in list covers southern Ontario, Québec and nearby US.</div>`;return}
 box.innerHTML='<div class="msg">Loading forecast…</div>';
 const u="https://api.open-meteo.com/v1/forecast?latitude="+list.map(t=>t.lat).join(",")+"&longitude="+list.map(t=>t.lon).join(",")
  +"&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,wind_speed_10m_max"
  +"&timezone=auto&start_date="+days[0]+"&end_date="+days[days.length-1];
 try{
  const r=await fetch(u);if(!r.ok)throw new Error(r.status);
  let j=await r.json();if(!Array.isArray(j))j=[j];
  if(my!==seq)return;
  const rows=list.map((t,i)=>{const d=j[i].daily;
   const per=days.map(s=>{const k=d.time.indexOf(s);return{s,code:d.weather_code[k],hi:Math.round(d.temperature_2m_max[k]),lo:Math.round(d.temperature_2m_min[k]),pop:d.precipitation_probability_max[k]??0,wind:Math.round(d.wind_speed_10m_max[k])}});
   return{...t,per,avg:per.reduce((a,w)=>a+score(w),0)/per.length}});
  const best=rows.reduce((a,b)=>b.avg>a.avg?b:a);
  rows.sort(sort==="drive"?(a,b)=>a.d.m-b.d.m:(a,b)=>b.avg-a.avg);
  box.innerHTML=rows.map(t=>`<div class="town"><div class="row"><span class="name">${esc(t.name)}${t===best?' <span class="pick">Best pick</span>':""}</span>
   <span class="meta">${t.d.est?"~":""}${mins(t.d.m)}</span></div>
   <div class="days">${t.per.map(w=>`<div class="d"><div class="meta">${dl(w.s)}</div><div class="ico" aria-hidden="true">${icon(w.code)}</div>
    <div class="t">${w.hi}°<small> / ${w.lo}°</small></div><div class="meta"><span class="rain">${w.pop}%</span> · ${w.wind} km/h</div></div>`).join("")}</div></div>`).join("");
 }catch(e){
  if(my===seq)box.innerHTML='<div class="msg">Couldn’t reach the forecast service. Open this app from its https link in Safari, and check your connection.</div>';
 }
}

$("strip").onclick=e=>{const b=e.target.closest("button");if(!b)return;
 sel.has(b.dataset.d)?sel.delete(b.dataset.d):sel.add(b.dataset.d);b.setAttribute("aria-pressed",sel.has(b.dataset.d));load()};
$("wk0").onclick=()=>weekend(0);$("wk1").onclick=()=>weekend(1);
$("clr").onclick=()=>{sel.clear();buildStrip();load()};
$("hrs").oninput=load;
$("sort").onclick=e=>{const b=e.target.closest("button");if(!b)return;sort=b.dataset.s;
 document.querySelectorAll("#sort button").forEach(x=>x.setAttribute("aria-pressed",x===b));load()};
$("mine").onclick=e=>{const b=e.target.closest("button");if(!b)return;custom.splice(+b.dataset.i,1);store.set("dtw_custom",custom);renderMine();load()};
buildStrip();renderMine();showOrigin();weekend(0);
if(origin.live&&navigator.geolocation)navigator.geolocation.getCurrentPosition(
 p=>{if(Math.abs(p.coords.latitude-origin.lat)+Math.abs(p.coords.longitude-origin.lon)>0.05)setOrigin({...origin,lat:p.coords.latitude,lon:p.coords.longitude})},
 ()=>{},{timeout:8000});
</script>
</body>
</html>
